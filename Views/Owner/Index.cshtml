@model List<VeterinarySystem.Models.Owner>
@{
    ViewData["Title"] = "Propietarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Propietarios</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo propietario</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-hover">
    <thead class="table-dark">
    <tr>
        <th>Nombre</th>
        <th>Documento</th>
        <th>Teléfono</th>
        <th>Email</th>
        <th>Mascotas</th>
        <th>Estado</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var owner in Model)
    {
        <tr>
            <td>@owner.Name</td>
            <td>@owner.Document</td>
            <td>@owner.Phone</td>
            <td>@owner.Email</td>
            <td>@owner.Pets.Count</td>
            <td>
                @if (owner.IsBlocked)
                {
                    <span class="badge bg-danger">Bloqueado</span>
                }
                else
                {
                    <span class="badge bg-success">Activo</span>
                }
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@owner.Id" class="btn btn-sm btn-info">Ver</a>
                <a asp-action="Edit" asp-route-id="@owner.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@owner.Id" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>