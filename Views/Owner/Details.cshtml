@model VeterinarySystem.Models.Owner
@{
    ViewData["Title"] = "Detalle propietario";
}

<h2>@Model.Name</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Documento</dt>
    <dd class="col-sm-9">@Model.Document</dd>

    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@Model.Phone</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">
        @if (Model.IsBlocked)
        {
            <span class="badge bg-danger">Bloqueado hasta @Model.BlockedUntil?.ToString("dd/MM/yyyy")</span>
        }
        else
        {
            <span class="badge bg-success">Activo</span>
        }
    </dd>
</dl>

<h4 class="mt-4">Mascotas (@Model.Pets.Count)</h4>

@if (Model.Pets.Count == 0)
{
    <p class="text-muted">Este propietario no tiene mascotas registradas.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Especie</th>
                <th>Raza</th>
                <th>Edad</th>
                <th>Peso</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pet in Model.Pets)
            {
                <tr>
                    <td>@pet.Name</td>
                    <td>@pet.Species</td>
                    <td>@pet.Breed</td>
                    <td>@pet.Age años</td>
                    <td>@pet.Weight kg</td>
                    <td>
                        <a asp-controller="Pet" asp-action="Details" 
                           asp-route-id="@pet.Id" class="btn btn-sm btn-info">Ver</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-controller="Pet" asp-action="Create" asp-route-ownerId="@Model.Id" 
       class="btn btn-success">+ Agregar mascota</a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>